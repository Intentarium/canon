{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentarium.com/schemas/agency-map.schema.json",
  "title": "Intentarium Agency Map",
  "description": "A structured map of intent, actors, authority, boundaries, trust, evidence, escalation, and feedback.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "intent", "actors", "authority", "boundaries", "trust_signals", "evidence", "escalation", "feedback"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "id": { "type": "string", "pattern": "^agency-map\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "success_signals", "non_goals"],
      "properties": {
        "outcome": { "type": "string", "minLength": 1 },
        "success_signals": { "$ref": "#/$defs/nonEmptyStrings" },
        "non_goals": { "$ref": "#/$defs/strings" }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "role"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "kind": { "enum": ["person", "team", "service", "agent", "external"] },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "authority": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor", "actions", "scope", "conditions"],
        "properties": {
          "actor": { "type": "string" },
          "actions": { "$ref": "#/$defs/nonEmptyStrings" },
          "scope": { "type": "string", "minLength": 1 },
          "conditions": { "$ref": "#/$defs/strings" }
        }
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "enforcement"],
        "properties": {
          "rule": { "type": "string", "minLength": 1 },
          "enforcement": { "type": "string", "minLength": 1 }
        }
      }
    },
    "trust_signals": { "$ref": "#/$defs/ownedSignals" },
    "evidence": { "$ref": "#/$defs/ownedSignals" },
    "escalation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trigger", "route", "stop_condition"],
        "properties": {
          "trigger": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "minLength": 1 },
          "stop_condition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "feedback": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal", "owner", "cadence", "response"],
        "properties": {
          "signal": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "cadence": { "type": "string", "minLength": 1 },
          "response": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string" } },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "ownedSignals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal", "source", "freshness"],
        "properties": {
          "signal": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "freshness": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
