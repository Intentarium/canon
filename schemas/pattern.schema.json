{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentarium.com/schemas/pattern.schema.json",
  "title": "Intentarium Pattern",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "type", "version", "maturity", "status", "title", "summary", "audiences", "relationships", "disclosure", "approved_by", "license", "created", "updated"],
  "properties": {
    "id": { "type": "string", "pattern": "^pattern\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "const": "pattern" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "maturity": { "enum": ["hypothesis", "observed", "field-tested", "repeated", "reference", "deprecated"] },
    "status": { "enum": ["draft", "published", "withdrawn"] },
    "title": { "type": "string", "minLength": 8 },
    "summary": { "type": "string", "minLength": 24 },
    "audiences": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports", "contradicts", "depends_on"],
      "properties": {
        "supports": { "$ref": "#/$defs/patternIds" },
        "contradicts": { "$ref": "#/$defs/patternIds" },
        "depends_on": { "$ref": "#/$defs/patternIds" }
      }
    },
    "disclosure": { "const": "green" },
    "approved_by": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "license": { "const": "CC-BY-4.0" },
    "created": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" }
  },
  "$defs": {
    "patternIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^pattern\\." }
    }
  }
}
